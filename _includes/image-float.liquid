{% assign float_align = include.align | default: 'left' %}
{% if float_align == 'right' %}
  {% assign float_margins = 'margin-left: 20px; margin-right: 0;' %}
{% else %}
  {% assign float_margins = 'margin-right: 20px; margin-left: 0;' %}
{% endif %}

<div style="clear: both;">
  <img src="{{ include.image }}" alt="{{ include.alt }}" style="float: {{ float_align }}; {{ float_margins }} margin-bottom: 10px; margin-top: 15px; width: {{ include.width | default: '300px' }};">
  <div class="float-content">
    {{ include.content | markdownify }}
  </div>
  <style>
    .float-content ul {
      padding-left: 37rem !important;
      margin-left: 0 !important;
    }
    .float-content li {
      margin-left: 0 !important;
    }
  </style>
</div>