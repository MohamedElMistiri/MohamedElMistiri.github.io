{% assign float_align = include.align | default: 'right' %}
{% if float_align == 'left' %}
  {% assign float_margins = 'margin-right: 20px; margin-left: 0;' %}
{% else %}
  {% assign float_margins = 'margin-left: 20px; margin-right: 0;' %}
{% endif %}

<div style="clear: both;">
  <div style="float: {{ float_align }}; {{ float_margins }} margin-bottom: 10px; margin-top: 15px; width: {{ include.width | default: '300px' }};">
    {% include video.liquid path=include.path width=include.width height=include.height %}
  </div>
  <div class="float-content">
    {{ include.content | markdownify }}
  </div>
</div>